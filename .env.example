# Copy to .env and fill from AWS Cognito User Pool + App client

VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your_spa_client_id

# Google SSO (Cognito Hosted UI / OAuth)
# Domain: Cognito console → User pool → App integration → Domain
VITE_COGNITO_DOMAIN=your-prefix.auth.us-east-1.amazoncognito.com
# Must match an allowed callback URL on the app client (include /auth/callback)
VITE_COGNITO_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
# Must match StockApp → Login pages → OpenID Connect scopes (default app request: openid email)
# VITE_COGNITO_OAUTH_SCOPES=openid email profile

# identity microservice (when running locally)
VITE_IDENTITY_API_URL=http://localhost:8081

# Dev only: verbose [auth] logs in browser console (on by default with npm run dev)
# VITE_AUTH_DEBUG=true

# Dev only: skip Cognito on sign-up and call POST /register directly
VITE_DEV_SKIP_COGNITO=true
