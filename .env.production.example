# Copy to .env.production (never commit). Used by `vite build` and scripts/deploy-cloudfront.ps1

VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your_spa_client_id

VITE_COGNITO_DOMAIN=your-prefix.auth.us-east-1.amazoncognito.com
# Must match a Cognito app-client callback URL exactly
VITE_COGNITO_OAUTH_REDIRECT_URI=https://d111111abcdef8.cloudfront.net/auth/callback

# Lightsail HTTPS reverse proxy (sslip.io host from bootstrap-lightsail.sh)
VITE_IDENTITY_API_URL=https://1-2-3-4.sslip.io/identity
VITE_MARKET_API_URL=https://1-2-3-4.sslip.io/market
VITE_PORTFOLIO_API_URL=https://1-2-3-4.sslip.io/portfolio

VITE_DEV_SKIP_COGNITO=false
